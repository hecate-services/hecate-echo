{application, hecate_echo, [
    {description, "Always-on io.macula.echo, the mesh's hello-world target every SDK quickstart calls"},
    {vsn, "0.1.0"},
    {registered, [hecate_echo_sup]},
    {mod, {hecate_echo_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        hecate_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-services/hecate-echo"}]}
]}.
